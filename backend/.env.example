# OFFERPROOF Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
APP_NAME=OFFERPROOF API
APP_VERSION=0.2.0

# Phase 2: AI Provider Configuration (Optional)
# Supported values: "gemini", "openai", "none" (defaults to "none" if keys not provided)
AI_PROVIDER=none
AI_REQUEST_TIMEOUT_SECONDS=25.0

# Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI-Compatible API Configuration (OpenAI, Groq, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
