# =============================================================================
# OFFERPROOF Backend Production & Local Configuration
# =============================================================================

# Server Binding
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Allowed CORS Origins (comma-separated list of allowed frontend origins, or * for open CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://offerproof.vercel.app

# =============================================================================
# AI Extraction Configuration (Optional)
# Supported values: "none" (default deterministic rule-based fallback), "gemini", "openai"
# The backend operates completely without any AI keys configured!
# =============================================================================
AI_PROVIDER=none
AI_REQUEST_TIMEOUT_SECONDS=25.0

# Gemini API Configuration (Required only if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI-Compatible Configuration (Required only if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
